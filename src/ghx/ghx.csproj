<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ghx</PackageId>
    <RootNamespace>ghx</RootNamespace>
    <AssemblyName>ghx</AssemblyName>
    <Description>Execute the bundled GitHub CLI. ndnx ghx -- repo list.</Description>
    <PackAsTool>true</PackAsTool>
    <PublishAot>true</PublishAot>
    <ToolCommandName>ghx</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
    <RestoreSources Condition="Exists('$(PackageOutputPath)')">$(PackageOutputPath);$(RestoreSources)</RestoreSources>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>

  <!--
    Pointer (`dotnet pack`): DotnetTool v2 settings listing ghx.{rid}.
    RID (`dotnet pack -r`): AOT tool plus the GitHub.Cli Payload.
    Do not suffix PackageId here; the SDK appends $(RuntimeIdentifier) for DotnetToolRidPackage.
  -->

  <ItemGroup>
    <PackageReference Include="GitHub.Cli" Version="$(Version)" />
    <PackageReference Include="Readme" Version="1.2.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
