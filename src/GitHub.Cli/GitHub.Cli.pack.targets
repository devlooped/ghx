<Project>
  <!-- Pointer vs RID pack. Imported only by GitHub.Cli.csproj; not shipped. -->
  <PropertyGroup>
    <GitHubCliPackageId Condition="'$(GitHubCliPackageId)' == ''">$(PackageId)</GitHubCliPackageId>
    <NoWarn>$(NoWarn);NU5100;NU5110;NU5111;NU5118;NU5119;NU5128;NU5129</NoWarn>
    <IncludeBuildOutput Condition="'$(RuntimeIdentifier)' == ''">true</IncludeBuildOutput>
    <IncludeBuildOutput Condition="'$(RuntimeIdentifier)' != ''">false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking Condition="'$(RuntimeIdentifier)' != ''">true</SuppressDependenciesWhenPacking>
    <PackageId Condition="'$(RuntimeIdentifier)' != ''">$(GitHubCliPackageId).$(RuntimeIdentifier)</PackageId>
    <TargetsForTfmSpecificContentInPackage Condition="'$(RuntimeIdentifier)' != ''">$(TargetsForTfmSpecificContentInPackage);PackGitHubCliPayload</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <UsingTask TaskName="JsonPoke" AssemblyFile="$(PkgJsonPoke)\build\JsonPoke.dll" Condition="'$(PkgJsonPoke)' != '' and Exists('$(PkgJsonPoke)\build\JsonPoke.dll')" />
  <UsingTask TaskName="JsonPeek" AssemblyFile="$(PkgJsonPeek)\build\JsonPeek.dll" Condition="'$(PkgJsonPeek)' != '' and Exists('$(PkgJsonPeek)\build\JsonPeek.dll')" />

  <Target Name="RestoreGitHubCliPayload"
          BeforeTargets="BeforeCompile;GetCopyToOutputDirectoryItems;AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildThisFileDirectory)payload.ps1;$(MSBuildThisFileDirectory)payload.functions.ps1;$(MSBuildThisFileDirectory)..\..\github-cli.version"
          Outputs="$(GitHubCliPayloadRoot)\.payload">
    <Error Condition="'$(GitHubCliVersion)' == ''" Text="GitHubCliVersion is empty; expected github-cli.version at the repo root." />
    <PropertyGroup>
      <_PayloadRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_PayloadRid>
      <_PayloadRid Condition="'$(_PayloadRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_PayloadRid>
      <_PayloadRid Condition="'$(_PayloadRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</_PayloadRid>
      <_PayloadRid Condition="'$(_PayloadRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_PayloadRid>
      <_PayloadRid Condition="'$(_PayloadRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</_PayloadRid>
    </PropertyGroup>
    <Error Condition="'$(_PayloadRid)' == ''" Text="Could not determine a Payload RID." />
    <MakeDir Directories="$(GitHubCliPayloadRoot)" />
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)payload.ps1&quot; -Rid &quot;$(_PayloadRid)&quot; -GitHubCliVersion &quot;$(GitHubCliVersion)&quot; -OutDir &quot;$(GitHubCliPayloadRoot)&quot;" />
  </Target>

  <Target Name="WriteGitHubCliRuntimeJson"
          BeforeTargets="_GetPackageFiles;GenerateNuspec"
          Condition="'$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_GitHubCliRuntimeJson>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)runtime.json'))</_GitHubCliRuntimeJson>
    </PropertyGroup>
    <ItemGroup>
      <_GitHubCliRid Include="$(RuntimeIdentifiers)" />
    </ItemGroup>
    <Error Condition="'@(_GitHubCliRid)' == ''" Text="gh.cli pointer pack requires RuntimeIdentifiers so runtime.json can map RID packages." />
    <Error Condition="'$(PkgJsonPoke)' == '' or !Exists('$(PkgJsonPoke)\build\JsonPoke.dll')" Text="JsonPoke was not restored; cannot write runtime.json." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(_GitHubCliRuntimeJson)))" />
    <WriteLinesToFile File="$(_GitHubCliRuntimeJson)" Lines="{&quot;runtimes&quot;:{}}" Overwrite="true" />
    <JsonPoke
      ContentPath="$(_GitHubCliRuntimeJson)"
      Query="$.runtimes['%(_GitHubCliRid.Identity)']['$(GitHubCliPackageId)']['$(GitHubCliPackageId).%(_GitHubCliRid.Identity)']"
      Value="'[$(Version), )'" />
    <JsonPeek ContentPath="$(_GitHubCliRuntimeJson)" Query="$.runtimes">
      <Output TaskParameter="Result" ItemName="_GitHubCliWrittenRuntimes" />
    </JsonPeek>
    <Error
      Condition="'@(_GitHubCliWrittenRuntimes)' == ''"
      Text="runtime.json has no runtimes after writing RIDs from RuntimeIdentifiers." />
    <ItemGroup>
      <None Include="$(_GitHubCliRuntimeJson)" Pack="true" PackagePath="runtime.json" />
    </ItemGroup>
  </Target>

  <Target Name="StripTargetsFromRidPack" BeforeTargets="_GetPackageFiles;GenerateNuspec" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <None Remove="build\**" />
      <None Remove="buildTransitive\**" />
      <Content Remove="build\**" />
      <Content Remove="buildTransitive\**" />
    </ItemGroup>
  </Target>

  <Target Name="PackGitHubCliPayload" DependsOnTargets="RestoreGitHubCliPayload" Condition="'$(RuntimeIdentifier)' != ''" Returns="@(TfmSpecificPackageFile)">
    <Error Condition="!Exists('$(GitHubCliPayloadRoot)')" Text="gh.cli RID pack requires a Payload at $(GitHubCliPayloadRoot)." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(GitHubCliPayloadRoot)\**\*" Exclude="$(GitHubCliPayloadRoot)\.payload">
        <PackagePath>gh/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
