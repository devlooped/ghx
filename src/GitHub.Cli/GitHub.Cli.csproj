<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>GitHub.Cli</PackageId>
    <RootNamespace>GitHub</RootNamespace>
    <AssemblyName>GitHub.Cli</AssemblyName>
    <Description>GitHub CLI payload for .NET: PackageReference GitHub.Cli and publish/pack for your RID to get gh/ plus GitHub.Cli.ResolvePath.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <GitHubCliVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\github-cli.version').Trim())</GitHubCliVersion>
    <_CurrentRid>$(NETCoreSdkPortableRuntimeIdentifier)</_CurrentRid>
    <_CurrentRid Condition="'$(_CurrentRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</_CurrentRid>
    <_CurrentRid Condition="'$(_CurrentRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_CurrentRid>
    <_CurrentRid Condition="'$(_CurrentRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</_CurrentRid>
    <GitHubCliPayloadRoot Condition="'$(RuntimeIdentifier)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)payload\$(RuntimeIdentifier)'))</GitHubCliPayloadRoot>
    <GitHubCliPayloadRoot Condition="'$(RuntimeIdentifier)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)payload\$(_CurrentRid)'))</GitHubCliPayloadRoot>
  </PropertyGroup>

  <!--
    Pointer (`dotnet pack`): lib/net10.0/GitHub.Cli.dll + runtime.json + buildTransitive targets.
    RID (`dotnet pack -r`): gh/** Payload. Not PackAsTool — a DotnetTool pointer cannot be PackageReferenced (NU1212).
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
    <PackageReference Include="JsonPeek" Version="1.3.0" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="JsonPoke" Version="1.3.0" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Readme" Version="1.2.1" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="GitHub.Cli.pack.targets" />
  <Import Project="buildTransitive\GitHub.Cli.targets" Condition="'$(GitHubCliTargetsImported)' != 'true'" />

  <ItemGroup>
    <None Include="buildTransitive\GitHub.Cli.targets" Pack="$(IncludeBuildOutput)" PackagePath="buildTransitive\GitHub.Cli.targets" />
    <None Include="build\GitHub.Cli.targets" Pack="$(IncludeBuildOutput)" PackagePath="build\GitHub.Cli.targets" />
  </ItemGroup>
</Project>
